# ==============================================================================
# HOMELAB BACKUP AUTOMATION
# ==============================================================================

# Daily PBS backup orchestration at 1:00 PM.

0 13 * * * /usr/local/bin/backup-orchestrator.sh

# Power off the main Proxmox host at midnight and schedule
# an RTC wake-up 7 hours later (25,200 seconds).

00 00 * * * /usr/sbin/rtcwake -m off -s 25200